# ============================================================================
#  Copy this file to ".env" (or ".env.local") and fill in the real values.
#  NEVER commit your real .env file. After changing any NEXT_PUBLIC_* value
#  you must rebuild (npm run build) because those values are inlined at build.
# ============================================================================

# ---- BRAND (single source of truth) ----------------------------------------
# Change this ONE variable to rename the product everywhere
# (navbar, footer, cards, SEO, legal pages, manifest, share text...).
NEXT_PUBLIC_APP_NAME=Matchmates
NEXT_PUBLIC_APP_TAGLINE=Let your squad pick their person.
NEXT_PUBLIC_COMPANY_NAME=ELVOROZ
NEXT_PUBLIC_CONTACT_EMAIL=contact@elvoroz.com

# Public URL of the site (no trailing slash). Used for SEO, OG images, sitemap.
# Example: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- FESTIVAL COUNTDOWN (homepage) ------------------------------------------
# ISO date-time with timezone. Karwa Chauth 2026 = 29 Oct 2026, moonrise ~8:17 PM IST (Delhi).
NEXT_PUBLIC_FESTIVAL_NAME=Karwa Chauth
NEXT_PUBLIC_FESTIVAL_DATETIME=2026-10-29T20:17:00+05:30

# ---- DATABASE (MongoDB) ------------------------------------------------------
# Your MongoDB connection string (Atlas or any host). REQUIRED.
MONGODB_URI=
# Database name used by the app (any name you like).
MONGODB_DB=friendpoll

# ---- SECURITY ------------------------------------------------------------------
# REQUIRED in production. Long random string (>= 32 chars). Used to hash IPs,
# device tokens and creator keys. Generate with:  openssl rand -hex 32
SECURITY_SALT=

# How many days a poll (and its votes) live before MongoDB auto-deletes them.
NEXT_PUBLIC_QUIZ_TTL_DAYS=14
# Hard cap of votes per poll (abuse protection).
MAX_VOTES_PER_QUIZ=500

# ---- ANALYTICS / SEARCH CONSOLE (optional) --------------------------------------
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
# When set, a consent banner appears and GA only loads after "Accept".
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (only the content value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
